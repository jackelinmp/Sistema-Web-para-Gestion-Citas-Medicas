# Copie este archivo como .env (el .env NUNCA se sube a GitHub) y complete los valores.
# En Render no se usa archivo: estas mismas claves se cargan en Environment del servicio.

APP_DEBUG=true          # false en producción

# Base de datos PostgreSQL. Con Supabase use el «Session pooler» (Connect > Session pooler):
DB_HOST=aws-0-REGION.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.REFERENCIA_DEL_PROYECTO
DB_PASS=
DB_SSLMODE=require       # con un PostgreSQL local use: prefer

# Solo en la nube (Render): la sesión viaja cifrada en una cookie porque el disco no es permanente.
# SESSION_DRIVER=cookie
# APP_KEY=una_clave_larga_y_aleatoria
# APP_URL=https://clinica-vida-salud.onrender.com

# Correo para «Recuperar contraseña» (opcional; sin esto, con APP_DEBUG=true el enlace se muestra en pantalla)
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USER=cuenta@gmail.com
# MAIL_PASS=contraseña_de_aplicacion
# MAIL_FROM=cuenta@gmail.com
# MAIL_FROM_NAME="Clínica Vida Salud"

# Asistente virtual con IA (opcional; sin esto usa reglas locales). Groq es gratis: https://console.groq.com
# AI_API_KEY=gsk_tu_clave_aqui
# AI_API_URL=https://api.groq.com/openai/v1
# AI_MODEL=openai/gpt-oss-20b
